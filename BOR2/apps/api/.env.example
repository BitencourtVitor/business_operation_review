# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Application
API_PORT=8080
APP_ENV=production
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=https://your-domain.com

# CORS
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Cron-triggered internal endpoints (/ofi/calculate, /qb/sync, /qbtime/period-report/sync)
CRON_SECRET=your_cron_secret_here

# QuickBooks Online OAuth app (shared by all companies: hvac, framing, pcg)
QB_CLIENT_ID=your_qb_client_id
QB_CLIENT_SECRET=your_qb_client_secret
QB_REDIRECT_URI=https://your-api-domain.com/api/v1/qb/callback
QB_ENCRYPTION_KEY=your_qb_token_encryption_key

# Machine-to-machine callers reading QB tokens via GET /api/v1/qb/token
# (e.g. the AutoAccounting service) — separate from CRON_SECRET on purpose.
AUTOACCOUNTING_SERVICE_SECRET=your_autoaccounting_service_secret

# Email (Gmail)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Premium Storage (Supabase)
PREMIUM_STORAGE_URL=https://your-supabase-url.supabase.co
PREMIUM_STORAGE_KEY=your_supabase_anon_key_here
