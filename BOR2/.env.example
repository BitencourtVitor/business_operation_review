# =============================================================================
# BOR2 — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/bor2

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=8080
API_ENV=development

# ─── AUTH (Better Auth) ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-secret-32-chars
BETTER_AUTH_URL=http://localhost:8080

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── QUICKBOOKS ───────────────────────────────────────────────────────────────
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=

# ─── EXTERNAL INTEGRATIONS ────────────────────────────────────────────────────
SAMSARA_API_KEY=
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
